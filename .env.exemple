# ─────────────────────────────────────────────────────────────
#  OASIS EBook Création — configuration
#  Copiez ce fichier sous le nom « .env » et remplissez vos valeurs.
#  Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).
#  Sur Render, utilisez plutôt les variables d'environnement du service.
# ─────────────────────────────────────────────────────────────

# Mot de passe de l'espace administrateur (dashboard + espace éditeur)
ADMIN_MDP=ChangezMoiAvantLaProduction

# ── Passerelle de paiement PLOP PLOP ──
# À récupérer dans votre tableau de bord marchand, section API / développeur.
# Ce ne sont PAS vos identifiants de connexion au portail.
PLOP_CLIENT_ID=pp_votre_identifiant_marchand
PLOP_CLIENT_SECRET=votre_cle_secrete_de_64_caracteres

# Port d'écoute (3000 par défaut ; ne rien définir sur Render)
# PORT=3000
